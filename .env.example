# Access token from portal-beta: log in as a company admin → Account → Access Tokens.
# The embed bills this token's company, so use a test company.
SCANIFLY_API_KEY=

# Defaults to beta. Point at http://localhost:3000/api for a local portal-be.
# SCANIFLY_API_URL=https://api.portal-beta.scanifly.com/api

# Optional: the signingSecret of a webhook subscription whose callbackUrl is <public url>/webhooks/scanifly.
# Without it, deliveries still show in the panel, marked unsigned.
# SCANIFLY_WEBHOOK_SECRET=
